#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

python3 -m compileall -q xraylib bin/xray
python3 -m unittest discover -s tests -v

if command -v ruff >/dev/null 2>&1; then
  ruff format --check .
  ruff check .
elif command -v uv >/dev/null 2>&1; then
  uvx ruff format --check .
  uvx ruff check .
else
  printf '%s\n' 'ruff: OPTIONAL MISSING (Python compile check completed)'
fi

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck xray scripts/*
else
  sh -n xray scripts/install-cli scripts/uninstall-cli scripts/quality
  printf '%s\n' 'shellcheck: OPTIONAL MISSING (POSIX shell syntax passed)'
fi

qml_lint=$(command -v qmllint || true)
qml_format=$(command -v qmlformat || true)
[ -n "$qml_lint" ] || [ ! -x /usr/lib/qt6/bin/qmllint ] || qml_lint=/usr/lib/qt6/bin/qmllint
[ -n "$qml_format" ] || [ ! -x /usr/lib/qt6/bin/qmlformat ] || qml_format=/usr/lib/qt6/bin/qmlformat

if [ -n "$qml_format" ]; then
  qml_temp=$(mktemp -d)
  trap 'rm -r -- "$qml_temp"' EXIT INT TERM
  cp XRay.qml "$qml_temp/XRay.qml"
  "$qml_format" -i -w 2 -W 120 "$qml_temp/XRay.qml"
  cmp XRay.qml "$qml_temp/XRay.qml"
  rm -r -- "$qml_temp"
  trap - EXIT INT TERM
else
  printf '%s\n' 'qmlformat: OPTIONAL MISSING'
fi

if [ -n "$qml_lint" ]; then
  "$qml_lint" -I /usr/share/omarchy/shell XRay.qml
else
  printf '%s\n' 'qmllint: OPTIONAL MISSING'
fi

omarchy plugin validate .
jq -e '.schemaVersion == 1 and .id == "io.github.3eye3y3.xray" and (.kinds | index("overlay"))' manifest.json >/dev/null
git diff --check
